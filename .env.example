DISCORD_TOKEN=your_discord_token
CLIENT_ID=your_client_id
TMDB_API_KEY=your_tmdb_api_key
# Optional: register slash commands to one guild for instant updates (leave blank for global)
GUILD_ID=
# Optional: per-user per-command cooldown in seconds (default 3)
COOLDOWN_SECONDS=3
# Optional: emit structured JSON logs to stdout (default false)
LOG_JSON=false
